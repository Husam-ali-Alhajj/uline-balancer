# Copy to .env (never commit .env). All values are optional for local development.

# Local default is a SQLite file. For Supabase, paste the Postgres connection string
# from the Supabase dashboard (Project settings > Database), for example:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:5432/postgres
DATABASE_URL=sqlite:///./dev.db

ALLOWED_ORIGINS=http://localhost:5173
MAX_WORKER_PROCESSES=2
MAX_ACTIVE_RUNS=4
MAX_RUN_SECONDS=60
MAX_BODY_BYTES=1000000
