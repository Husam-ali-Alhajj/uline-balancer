{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "problem_input.schema.json",
  "title": "ProblemInput",
  "description": "Body of POST /runs and POST /validate. Cross-field rules that JSON Schema cannot express (unique task names, predecessors exist, no cycles, every task time <= cycle time) are enforced by the backend; see MASTER.md section 5 and backend/app/schemas/problem.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tasks", "working_time_per_day", "production_per_day"],
  "properties": {
    "title": { "type": ["string", "null"], "maxLength": 100, "description": "Optional label shown in run history." },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "time"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 40, "description": "Unique within the instance." },
          "time": { "type": "number", "exclusiveMinimum": 0, "description": "Task time in minutes." },
          "predecessors": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string" },
            "default": [],
            "description": "Names of DIRECT predecessors."
          }
        }
      }
    },
    "working_time_per_day": { "type": "number", "exclusiveMinimum": 0, "description": "Available working minutes per day." },
    "production_per_day": { "type": "integer", "minimum": 1, "description": "Units to produce per day." },
    "workers": { "type": ["integer", "null"], "minimum": 1, "description": "Optional override of the suggested worker count (decision D3, provisional)." },
    "ga_settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "population_size": { "type": "integer", "minimum": 10, "maximum": 500, "default": 50 },
        "max_generations": { "type": "integer", "minimum": 10, "maximum": 1000, "default": 100 },
        "crossover_rate": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.8 },
        "mutation_rate": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.1 },
        "elitism_count": { "type": "integer", "minimum": 0, "default": 2 },
        "tournament_size": { "type": "integer", "minimum": 2, "default": 3 },
        "stagnation_limit": { "type": "integer", "minimum": 1, "default": 30, "description": "Stop after this many generations without improvement." },
        "seed": { "type": ["integer", "null"], "minimum": 0, "description": "Same input + same seed = same result." }
      }
    }
  }
}
